# Copy these into Portainer's "Environment variables" (never commit real values).
TRIVY_MONITOR_IMAGE=ghcr.io/YOUR_GH_USER/trivy-monitor:latest
TZ=Europe/London

# --- what to scan ---
DOCKER_HOSTS=local=tcp://socket-proxy:2375
SEVERITIES=CRITICAL,HIGH            # add MEDIUM,LOW,UNKNOWN to widen
ONLY_FIXABLE=false                  # true = only report CVEs that have a fixed package version
CHECK_UPSTREAM=true                 # scan newer tags / rebuilt tag to recommend updates
IGNORE_IMAGES=                      # comma-separated globs, e.g. myreg/internal-*
CAUTION_PATTERNS=pihole,bunkerweb,wg-easy,guacamole,backrest,postgres,mysql,mariadb,redis

# --- when ---
SCHEDULE_CRON=0 6 * * 1             # Mondays 06:00 (5-field cron, container TZ)
RUN_ON_START=false                  # true = scan immediately after deploy (use once to test)

# --- email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls              # starttls | ssl | none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=you@example.com
SEND_CLEAN_REPORT=false             # true = also email when everything is clean
HEARTBEAT_URL=                      # e.g. Uptime Kuma push URL, pinged after each good run
DRY_RUN=false                       # true = print the report to logs instead of emailing

# --- stale-image detection and alternatives ---
STALE_DAYS=365                      # no newer tag and tag last published longer ago than this => "unmaintained"
SUGGEST_ALTERNATIVES=true           # suggest + scan maintained alternatives (src/trivy_monitor/alternatives.json,
                                    # extend with /data/alternatives.json in the monitor-data volume)

# --- archive each run's report to a NAS (dated directory, e.g. <ARCHIVE_PATH>/2026-10-19_060012/) ---
ARCHIVE_METHOD=none                 # none | local | rsync | sftp
# local = the NAS is this Docker host: no ssh needed, just a folder (must be writable by uid 10001)
ARCHIVE_LOCAL_DIR=                  # e.g. /mnt/nas/trivy-reports
ARCHIVE_HOST=
ARCHIVE_PORT=22
ARCHIVE_USER=
ARCHIVE_PATH=/volume1/backups/trivy-reports
ARCHIVE_KNOWN_HOSTS=                # output of: ssh-keyscan -t ed25519 <nas>  (verify the fingerprint!)
ARCHIVE_SSH_KEY_HOST_PATH=          # host path of the private key file, e.g. /home/you/.ssh/trivy_archive
ARCHIVE_KEEP_LOCAL=8                # runs kept in the monitor-data volume
